.venv/
__pycache__/
*.pyc
datos/
modelo/
extracto/
# lo que deja la ingesta al correr: su registro y su candado
registros/
.env*
!.env.example
.claude/

# capturas que genera calidad/capturar_ui.py; las del README sí se versionan
docs/capturas/*
!docs/capturas/captura-interfaz.png
!docs/capturas/captura-ficha-dead-space.png
!docs/capturas/captura-comparar.png
# Las capturas de los mockups pesan decenas de MB y salen del HTML con un comando.
docs/historial/mockups/capturas/

# herramienta local del túnel y carpetas de utilidades de agentes: nada de esto es del proyecto
*.deb
.agents/
.artifacts/
# la caché que deja Angular si se corre ng desde la raíz (la de frontend/ la ignora frontend/.gitignore)
/.angular/

# lo que genera la compilación del documento y los releases que baja generar_figuras.py
documento/build/
documento/.cache/
# de los PDF sueltos en documento/, solo se versiona el de entrega (lo deja make doc)
documento/*.pdf
!documento/documento-entregafinal.pdf
