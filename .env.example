# Copia este archivo como .env, en la raíz del repo, y llena lo que necesites. .env está en .gitignore:
# nunca se sube con valores. En Render, estas variables se cargan en Environment, no como un archivo.
#
# La API lee este archivo solo para las variables de Nia, las de la primera parte. Las de la segunda
# parte se leen del entorno del proceso y aquí no tienen efecto: en local, expórtalas en la terminal
# antes de `make api`; en Render, ponlas en Environment.

# --- Se leen de este archivo ---------------------------------------------------------------------

# Clave de OpenAI para el chat de Nia. Sin clave, Nia funciona en modo demostración:
# responde con reglas sobre los datos reales del juego.
OPENAI_API_KEY=

# Modelo de OpenAI que usa Nia (por ejemplo, alguno de la familia gpt-4o o gpt-4.1).
# Vacío también deja a Nia en modo demostración.
NEXPLAY_MODELO_NIA=

# Topes del chat: largo de la respuesta, segundos de espera y peticiones por minuto
# (el límite es por id de usuario y por IP, en memoria).
NEXPLAY_NIA_MAX_TOKENS=400
NEXPLAY_NIA_TIMEOUT=20
NEXPLAY_NIA_POR_MINUTO=10

# true con un modelo de razonamiento: pide 1,200 tokens y esfuerzo bajo, porque los tokens de pensar
# cuentan en el tope y con 400 la respuesta podía salir vacía. false con un modelo de chat.
NEXPLAY_NIA_RAZONAMIENTO=false

# --- Solo desde el entorno (aquí no tienen efecto) -----------------------------------------------

# Comentarios del hilo público por minuto, por usuario e IP. Reaccionar es un clic, no escribir, así
# que tiene su propio tope, más alto; los votos a las respuestas de Nia también.
# NEXPLAY_COMENTARIOS_POR_MINUTO=3
# NEXPLAY_REACCIONES_POR_MINUTO=30
# NEXPLAY_VOTOS_NIA_POR_MINUTO=30

# Orígenes extra permitidos por CORS, separados por coma. http://localhost:4200 siempre está
# permitido. Ejemplo: https://nexplay.vercel.app
# NEXPLAY_CORS_ORIGENES=

# Dónde guardar calificaciones, comentarios y votos. Por omisión, backend/datos/valoraciones.db; una
# ruta relativa se cuenta desde backend/, donde corre la API.
# NEXPLAY_VALORACIONES_DB=datos/valoraciones.db
