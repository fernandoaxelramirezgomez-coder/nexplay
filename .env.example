# Copia este archivo como .env y llena lo que necesites. .env está en .gitignore:
# nunca se sube con valores. En el despliegue, estas variables se cargan como
# secretos del proveedor (Repository secrets en Hugging Face, Environment en Render),
# no como un archivo.

# Clave de OpenAI para el chat de Nia. Sin clave, Nia funciona en modo demostración:
# responde con reglas sobre los datos reales del juego.
OPENAI_API_KEY=

# Modelo de OpenAI que usa Nia (por ejemplo, alguno de la familia gpt-4o o gpt-4.1).
# Vacío también deja a Nia en modo demostración.
NEXPLAY_MODELO_NIA=

# Topes del chat: largo de la respuesta, segundos de espera y peticiones por minuto
# (el límite es por id de usuario y por IP, en memoria).
NEXPLAY_NIA_MAX_TOKENS=400
NEXPLAY_NIA_TIMEOUT=20
NEXPLAY_NIA_POR_MINUTO=10

# Comentarios del hilo público: cuántos por minuto admite la API, por usuario e IP.
# Reaccionar es un clic, no escribir, así que tiene su propio tope más alto.
NEXPLAY_COMENTARIOS_POR_MINUTO=3
NEXPLAY_REACCIONES_POR_MINUTO=30

# Orígenes extra permitidos por CORS, separados por coma (localhost:4200 y :7860 ya
# están permitidos). Ejemplo: https://nexplay.vercel.app
NEXPLAY_CORS_ORIGENES=

# Rutas opcionales de datos.
# NEXPLAY_VALORACIONES_DB=datos/valoraciones.db
